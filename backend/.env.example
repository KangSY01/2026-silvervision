SECRET_KEY=change-me

# 로컬 개발에서만 True. 배포 환경에서는 반드시 False로 둔다
# (True면 오류 페이지에 소스와 설정이 그대로 노출된다).
DEBUG=True

# 쉼표로 구분. DEBUG=False면 반드시 채워야 한다(비면 모든 요청이 400).
# 실기기에서 PC의 LAN IP로 접속한다면 그 IP도 추가할 것.
ALLOWED_HOSTS=

DB_NAME=silvervision
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# 솔라피(Solapi) SMS - 응급 알림 실제 발송에 사용.
# 값을 비워두면 실제 문자를 보내지 않고 로그만 남긴다(테스트/CI). 실제 키는
# 커밋하지 않는다.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_NUMBER=
